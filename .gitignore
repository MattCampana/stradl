# Build output: `make build` writes ./bin, `make release` writes ./dist
/bin/
/dist/

# Root-level build output. `make build` targets ./bin, but a plain
# `go build -o claude-sync ./cmd/claude-sync` drops a ~55MB binary here,
# which a `git add -A` would commit into history permanently.
/claude-sync
/claude-sync.exe
/stradl

*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Dependency directories
vendor/
node_modules/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Local config (contains secrets)
.claude-sync/
.npmrc
.env
.env.*
